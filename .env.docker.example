# Copia este archivo como ".env" en la raíz del proyecto (junto a docker-compose.yml)
# Base de datos
PGUSER=sisvac_user
PGPASSWORD=cambiar_esta_clave
PGDATABASE=sisvac

# JWT
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# CIFRADO DE DATOS PERSONALES (OBLIGATORIO) — 64 caracteres hexadecimales.
# Genera una con:  docker compose run --rm backend node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GUÁRDALA EN UN LUGAR SEGURO (si se pierde, los datos cifrados no se recuperan).
ENCRYPTION_KEY=
HASH_KEY=

# Frontend
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000/api

# Correo (SMTP) — opcional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Telegram Bot — opcional
TELEGRAM_BOT_TOKEN=

# WhatsApp Business API — opcional
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# AWS — opcional
AWS_REGION=us-east-1
S3_BUCKET_NAME=
SNS_TOPIC_ARN_ALERTAS=
