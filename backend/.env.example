# Servidor
PORT=4000
NODE_ENV=development

# Base de datos PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=sisvac_user
PGPASSWORD=cambiar_esta_clave
PGDATABASE=sisvac

# JWT
JWT_SECRET=cambiar_por_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h

# ============================================================
# CIFRADO DE DATOS PERSONALES (OBLIGATORIO)
# 64 caracteres hexadecimales (32 bytes). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# GUÁRDALA EN UN LUGAR SEGURO: si se pierde o se cambia, los DPI,
# teléfonos y correos ya cifrados NO se pueden recuperar.
# ============================================================
ENCRYPTION_KEY=
# Opcional: clave aparte para el hash del DPI (si se omite se usa ENCRYPTION_KEY)
HASH_KEY=

# Correo (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notificaciones@centrosalud.gob.gt
SMTP_PASS=clave_de_aplicacion

# Telegram Bot
TELEGRAM_BOT_TOKEN=

# WhatsApp Business API
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Frontend (CORS)
FRONTEND_URL=http://localhost:5173

# AWS (solo si se despliega en Lambda / se usa S3 y SNS)
AWS_REGION=us-east-1
S3_BUCKET_NAME=
SNS_TOPIC_ARN_ALERTAS=
LAMBDA_SECURITY_GROUP_ID=
LAMBDA_SUBNET_ID_1=
LAMBDA_SUBNET_ID_2=
