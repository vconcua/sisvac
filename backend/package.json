{
  "name": "sisvac-backend",
  "version": "1.1.0",
  "description": "Sistema de Control de Crecimiento Infantil y Vacunación - API REST",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "psql -U $PGUSER -d $PGDATABASE -f database/schema.sql",
    "seed": "psql -U $PGUSER -d $PGDATABASE -f database/seed.sql",
    "deploy:aws": "serverless deploy"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.616.0",
    "@aws-sdk/client-sns": "^3.616.0",
    "@aws-sdk/s3-request-presigner": "^3.616.0",
    "axios": "^1.7.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-async-errors": "^3.1.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.66.0",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.20.2",
    "pg": "^8.12.0",
    "qrcode": "^1.5.3",
    "serverless-http": "^3.2.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "serverless": "^3.39.0",
    "serverless-offline": "^13.6.0"
  }
}
